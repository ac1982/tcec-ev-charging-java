<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.ac1982</groupId><artifactId>tcec-ev-charging-java</artifactId><version>1.0.0</version></parent>
  <artifactId>tcec-store-redis</artifactId>
  <name>TCEC optional Redis security stores</name>
  <dependencies>
    <dependency><groupId>io.github.ac1982</groupId><artifactId>tcec-core</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>redis.clients</groupId><artifactId>jedis</artifactId><version>8.0.1</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>redis-integration</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.5.4</version>
        <configuration><useModulePath>false</useModulePath><forkedProcessTimeoutInSeconds>120</forkedProcessTimeoutInSeconds></configuration>
        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
